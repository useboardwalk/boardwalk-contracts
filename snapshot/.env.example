# RPC URLs (override the public defaults; production SHOULD use private/archive endpoints).
RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
RPC_BASE=https://mainnet.base.org
RPC_FRAXTAL=https://rpc.frax.com
RPC_INK=https://rpc-gel.inkonchain.com
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
# Katana has NO reliable public default baked in — set this explicitly.
RPC_KATANA=

# Snapshot block per chain. Leave unset for `latest` (a LOUD warning is printed).
# PRODUCTION MUST pin the pre-go-live snapshot block on EVERY chain.
SNAPSHOT_BLOCK_ETHEREUM=
SNAPSHOT_BLOCK_BASE=
SNAPSHOT_BLOCK_FRAXTAL=
SNAPSHOT_BLOCK_INK=
SNAPSHOT_BLOCK_ARBITRUM=
SNAPSHOT_BLOCK_KATANA=

# For the reproducible audit pass, set SNAPSHOT_BLOCK_* to the reference block and re-run
# (see README "Two blocks"); there are no separate reference-block variables.

# Optional: deployment block of each BMX token, used as the lower bound for log discovery.
# If unset, discovery starts from block 0 (slow). Pin these for reproducibility.
BMX_DEPLOY_BLOCK_ETHEREUM=
BMX_DEPLOY_BLOCK_BASE=
BMX_DEPLOY_BLOCK_FRAXTAL=
BMX_DEPLOY_BLOCK_INK=
BMX_DEPLOY_BLOCK_ARBITRUM=
BMX_DEPLOY_BLOCK_KATANA=

# eth_getLogs chunk size (blocks per request). Lower it if an RPC rejects wide ranges.
LOG_CHUNK_SIZE=50000

# Multicall batch size (addresses per multicall). Lower it if an RPC times out.
MULTICALL_BATCH_SIZE=500
